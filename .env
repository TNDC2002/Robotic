# Local settings (see .env.example)

# --- Motor thrust (RL nav training / eval) ---
MOTOR_THRUST_MIN_N=0
MOTOR_THRUST_MAX_N=3

# --- GUI playback (eval / rl_interact_demo --gui) ---
GUI_STEP_SLEEP_S=0.1
GUI_REALTIME=0
GUI_FAST=0
GUI_UNLIMITED_EPISODE=1

# --- Hover balance / wind-tunnel demo ---
HOVER_BALANCE_MODE=0

# --- Wind (nav train/eval, hover demo) ---
WIND_ENABLED=1
WIND_INCLUDE_IN_OBS=1
WIND_SPEED_MIN=0.025
WIND_SPEED_MAX=0.05
WIND_DRAG_MIN=0.005
WIND_DRAG_MAX=0.01
WIND_QUAD_DRAG_MIN=0.0005
WIND_QUAD_DRAG_MAX=0.001
WIND_TURBULENCE_SCALE_MIN=0.005
WIND_TURBULENCE_SCALE_MAX=0.01
WIND_FORCE_NOISE_MIN=0.005
WIND_FORCE_NOISE_MAX=0.01
WIND_CORNER_NOISE_MIN=0.0005
WIND_CORNER_NOISE_MAX=0.001
WIND_TORQUE_NOISE_MIN=0.0005
WIND_TORQUE_NOISE_MAX=0.005
WIND_GUST_MIN=0.0
WIND_GUST_MAX=0.0

# --- Navigation spawn / goal altitude (meters) ---
NAV_SPAWN_Z=1.5
NAV_GOAL_Z_MAX_RISE=1.0
NAV_MAP_Z_MAX=2.5

# --- Navigation: safe tilt (degrees) ---
# Max angle between body +Z and world +Z (tilt from vertical), NOT separate roll/pitch caps.
SAFE_ATTITUDE_DEG=15
NAV_END_ON_UNSAFE_ATTITUDE=0
PENALTY_UNSAFE_ATTITUDE_END=3.0

# --- Navigation: rewards (REWARD_*) — per-step bonuses + success terminal ---
REWARD_W_PROGRESS=3.0
REWARD_W_GOAL_ALT_PROGRESS=5.0
REWARD_W_ALIVE=0.025
REWARD_W_UPRIGHT=0.0
REWARD_W_SAFE_ATTITUDE=0.1
# REWARD_W_SAFE_ATTITUDE=1.0
REWARD_SUCCESS_BONUS=3.0

# --- Navigation: penalties (PENALTY_*) — per-step costs + failure terminals ---
PENALTY_W_GOAL_DIST=0.01
PENALTY_W_GOAL_ALT=0.05
PENALTY_W_ATTITUDE=0.005
PENALTY_W_ANG_VEL=0.005
PENALTY_W_LIN_VEL=0.005
PENALTY_W_ACTION_RATE=0.0
PENALTY_W_UNSAFE_ATTITUDE=0.01
# PENALTY_W_UNSAFE_ATTITUDE=0.2
PENALTY_CRASH=3.0
PENALTY_TIME_LIMIT=0.0

# --- PPO learning rate schedule (train_nav_rl.py) ---
PPO_LEARNING_RATE=0.0001
PPO_LR_FINAL=0.0
PPO_LR_SCHEDULE=linear

# --- PPO checkpoint / model saves (train_nav_rl.py) ---
PPO_SAVE_CKPT=0
PPO_CKPT_FREQ=100000
PPO_SAVE_BEST=1
PPO_SAVE_FINAL=1

# --- PPO eval + early stopping (train_nav_rl.py) ---
# Eval runs during training; best model saved to runs/nav_ppo/best/ when PPO_SAVE_BEST=1.
PPO_EVAL_FREQ=20000
PPO_EVAL_EPISODES=5
# Stop training when eval mean reward fails to improve for PATIENCE consecutive evals.
PPO_EARLY_STOP=1
PPO_EARLY_STOP_PATIENCE=10
PPO_EARLY_STOP_MIN_DELTA=0.0
PPO_EARLY_STOP_MIN_EVALS=3
