# Copy to .env and edit (cp .env.example .env)
# Values here override shell/conda environment variables and code defaults.
# Explicit CLI flags (e.g. train_nav_rl.py --lr) override .env for that run only.

# --- Motor thrust (RL nav training / eval) ---
# Linear map action [-1, 1] -> [MIN, MAX] N per rotor:
#   thrust_N = MIN + (MAX - MIN) * (action + 1) / 2
MOTOR_THRUST_MIN_N=0
MOTOR_THRUST_MAX_N=4

# --- GUI playback (eval / rl_interact_demo --gui) ---
GUI_STEP_SLEEP_S=0.01
GUI_REALTIME=0
GUI_FAST=0
# 1 = no episode time limit in GUI; ends on success/crash (nav) or crash/flip/OOB (hover demo)
GUI_UNLIMITED_EPISODE=0

# --- Hover balance / wind-tunnel demo ---
# Fixed m·g/4 per motor; drone floats while wind pushes it (see rl_interact_demo --hover-balance)
HOVER_BALANCE_MODE=0

# --- Wind (nav train/eval, hover demo) — one sample per episode from each MIN/MAX range ---
# WIND_ENABLED=0 or --no-wind disables wind entirely.
# Horizontal speed + random direction each episode; drag/turbulence/noise drawn uniformly in range.
WIND_ENABLED=1
WIND_INCLUDE_IN_OBS=1
# WIND_SEED=42
WIND_SPEED_MIN=0.5
WIND_SPEED_MAX=2.5
WIND_DRAG_MIN=0.35
WIND_DRAG_MAX=0.75
WIND_QUAD_DRAG_MIN=0.03
WIND_QUAD_DRAG_MAX=0.08
WIND_TURBULENCE_SCALE_MIN=1.0
WIND_TURBULENCE_SCALE_MAX=3.0
WIND_FORCE_NOISE_MIN=0.08
WIND_FORCE_NOISE_MAX=0.5
WIND_CORNER_NOISE_MIN=0.04
WIND_CORNER_NOISE_MAX=0.15
WIND_TORQUE_NOISE_MIN=0.03
WIND_TORQUE_NOISE_MAX=0.12
WIND_GUST_MIN=0.0
WIND_GUST_MAX=0.5

# --- Navigation spawn / goal altitude (meters) ---
# Spawn is higher than hover demo default for more margin before floor crash (crash_z ≈ 0.12 m).
# Goal Z is sampled uniformly in [NAV_SPAWN_Z, NAV_SPAWN_Z + NAV_GOAL_Z_MAX_RISE] (never below spawn).
NAV_SPAWN_Z=1.25
NAV_GOAL_Z_MAX_RISE=0.35
NAV_MAP_Z_MAX=1.65

# --- Navigation: safe tilt (degrees) ---
# Max angle between body +Z and world +Z (tilt from vertical), NOT separate roll/pitch caps.
SAFE_ATTITUDE_DEG=70
# 1 = end episode when tilt >= SAFE_ATTITUDE_DEG (helps credit assignment vs endless tumbling)
NAV_END_ON_UNSAFE_ATTITUDE=0
PENALTY_UNSAFE_ATTITUDE_END=50.0

# --- Navigation: rewards (REWARD_*) — per-step bonuses + success terminal; see REWARD.md ---
REWARD_W_PROGRESS=8.0
REWARD_W_GOAL_ALT_PROGRESS=4.0
REWARD_W_ALIVE=0.02
REWARD_W_UPRIGHT=0.15
REWARD_W_SAFE_ATTITUDE=1.0
REWARD_SUCCESS_BONUS=120.0

# --- Navigation: penalties (PENALTY_*) — per-step costs + failure terminals ---
PENALTY_W_GOAL_DIST=0.4
PENALTY_W_GOAL_ALT=1.0
PENALTY_W_ATTITUDE=1.2
PENALTY_W_ANG_VEL=0.06
PENALTY_W_LIN_VEL=0.04
PENALTY_W_ACTION_RATE=0.02
PENALTY_W_UNSAFE_ATTITUDE=5.0
PENALTY_CRASH=80.0
PENALTY_TIME_LIMIT=15.0

# --- PPO learning rate schedule (train_nav_rl.py) ---
PPO_LEARNING_RATE=0.0003
PPO_LR_FINAL=0.00001
PPO_LR_SCHEDULE=linear

# --- PPO checkpoint / model saves (train_nav_rl.py → runs/nav_ppo/) ---
PPO_SAVE_CKPT=1
PPO_CKPT_FREQ=50000
PPO_SAVE_BEST=1
PPO_SAVE_FINAL=1

# Continue training from an existing checkpoint (.zip). Empty = train from scratch.
# Timestep counter always resets. Optimizer optional (see PPO_RESUME_LOAD_OPTIMIZER).
# PPO_RESUME_MODEL=runs/nav_ppo/best/best_model.zip
PPO_RESUME_MODEL=
PPO_RESUME_LOAD_OPTIMIZER=0

# --- PPO eval + early stopping (train_nav_rl.py) ---
PPO_EVAL_FREQ=20000
PPO_EVAL_EPISODES=5
PPO_EARLY_STOP=0
PPO_EARLY_STOP_PATIENCE=5
PPO_EARLY_STOP_MIN_DELTA=0.0
PPO_EARLY_STOP_MIN_EVALS=3
