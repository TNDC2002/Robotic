# Copy to .env and edit (cp .env.example .env)

# --- Motor thrust (RL nav training / eval) ---
# Linear map action [-1, 1] -> [MIN, MAX] N per rotor:
#   thrust_N = MIN + (MAX - MIN) * (action + 1) / 2
MOTOR_THRUST_MIN_N=0
MOTOR_THRUST_MAX_N=4

# --- GUI playback (eval / rl_interact_demo --gui) ---
GUI_STEP_SLEEP_S=0.01
GUI_REALTIME=0
GUI_FAST=0

# --- Hover balance / wind-tunnel demo ---
# Fixed m·g/4 per motor; drone floats while wind pushes it (see rl_interact_demo --hover-balance)
HOVER_BALANCE_MODE=0

# --- Fixed wind (demo, or nav when WIND_RANDOMIZATION=0) ---
WIND_ENABLED=1
WIND_VX=1.0
WIND_VY=0.0
WIND_VZ=0.0
WIND_DRAG=0.4
WIND_QUAD_DRAG=0.04
WIND_GUST=0.0
WIND_GUST_FREQ_HZ=0.15
WIND_VERTICAL_GUST_COUPLING=0.12
# Turbulence: scale * (base_x, base_y, base_z) m/s OU process
WIND_TURBULENCE_SCALE=1.0
WIND_TURBULENCE_BASE_X=0.4
WIND_TURBULENCE_BASE_Y=0.4
WIND_TURBULENCE_BASE_Z=0.06
WIND_TURBULENCE_TAU_S=0.3
# Extra drag noise (N); vertical scaled by *_Z_SCALE
WIND_FORCE_NOISE=0.12
WIND_FORCE_NOISE_Z_SCALE=0.25
WIND_CORNER_NOISE=0.08
WIND_CORNER_NOISE_Z_SCALE=0.25
WIND_TORQUE_NOISE=0.04
# WIND_SEED=42
WIND_INCLUDE_IN_OBS=1

# --- Random wind per episode (nav training; set 0 for fixed WIND_* above) ---
WIND_RANDOMIZATION=1
WIND_SPEED_MIN=0.5
WIND_SPEED_MAX=2.5
WIND_DRAG_MIN=0.35
WIND_DRAG_MAX=0.75
WIND_QUAD_DRAG_MIN=0.03
WIND_QUAD_DRAG_MAX=0.08
WIND_TURBULENCE_SCALE_MIN=2.0
WIND_TURBULENCE_SCALE_MAX=10.0
WIND_FORCE_NOISE_MIN=0.08
WIND_FORCE_NOISE_MAX=0.5
WIND_CORNER_NOISE_MIN=0.04
WIND_CORNER_NOISE_MAX=0.15
WIND_TORQUE_NOISE_MIN=0.03
WIND_TORQUE_NOISE_MAX=0.12
WIND_GUST_MIN=0.0
WIND_GUST_MAX=0.5
